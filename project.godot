; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Aether Frontier"
config/version="0.26.0"
run/main_scene="res://scenes/pregame/loading_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/original/items/core_egg.svg"

[autoload]

QuestManager="*res://scripts/quest_manager.gd"
GameChat="*res://scripts/game_chat.gd"
GameManager="*res://scripts/GameManager.gd"
InventoryManager="*res://scripts/InventoryManager.gd"
VisualDirector="*res://scripts/visual/visual_director.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[layer_names]

2d_physics/layer_1="World"
2d_physics/layer_2="Warden"
2d_physics/layer_3="WildMonster"
2d_physics/layer_4="Partner"

[physics]

common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
